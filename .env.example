# Copy to .env at the repo root. Values match infra/docker-compose.yml.

# Migrations and seed (owner role)
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/rental
# API (row-level security enforced)
DATABASE_URL=postgres://rental_app:rental_app@localhost:5432/rental
# Ingestion service (bypasses RLS, writes for all tenants)
DATABASE_URL_INGEST=postgres://rental_ingest:rental_ingest@localhost:5432/rental

REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883

API_PORT=4000
# Browser origins allowed to call the API (web app, Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Until authentication is added, the API acts as this organization (printed by `pnpm db:seed`)
DEV_ORG_ID=00000000-0000-4000-8000-000000000001

# Next.js and Expo read env files from their own folders: copy these two lines
# into apps/web/.env.local and apps/mobile/.env.local if you need other values.
# On a physical phone use your computer's LAN IP instead of localhost.
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Ingestion: which provider adapters to start, and a stable per-instance name
# (defaults to the hostname; must differ between instances)
INGEST_PROVIDERS=simulator
# INGEST_CONSUMER_NAME=

# Simulator
SIM_DEVICE_COUNT=50
SIM_INTERVAL_MS=5000
