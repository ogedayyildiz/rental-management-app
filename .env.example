# Local development only. Copy to .env and choose a local password before starting Docker.
POSTGRES_USER=rental
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=rental
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend Prisma connection. Redis remains reserved for later queue integration.
# Keep the password in DATABASE_URL consistent with POSTGRES_PASSWORD (URL-encoded).
DATABASE_URL=postgresql://rental:replace-with-a-local-password@127.0.0.1:5432/rental
REDIS_URL=redis://127.0.0.1:6379

# Bootstrap services bind locally by default.
HOST=127.0.0.1
API_PORT=3001
TELEMETRY_PORT=3002
WORKER_PORT=3003

# API: exact HTTPS issuer with trailing slash; values come from your Auth0 tenant.
AUTH0_ISSUER=
AUTH0_AUDIENCE=
# Comma-separated web and native application client IDs; no M2M clients.
AUTH0_ALLOWED_CLIENT_IDS=

# Web: also provide these in apps/web/.env.local (Next does not load root .env).
# AUTH0_DOMAIN is a hostname without https:// or a trailing slash.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate a random 32-byte hex session encryption key locally.
AUTH0_SECRET=
APP_BASE_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:3001

# Mobile: provide in apps/mobile/.env; all EXPO_PUBLIC values are public.
# No client secret is used by the mobile application.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=
EXPO_PUBLIC_AUTH0_SCHEME=
EXPO_PUBLIC_API_BASE_URL=
MOBILE_IOS_BUNDLE_IDENTIFIER=
MOBILE_ANDROID_PACKAGE=
