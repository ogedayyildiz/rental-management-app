{
  "name": "@rental/ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rental/db": "workspace:*",
    "@rental/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "mqtt": "^5.16.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
